# Supabase (público) — Settings → API en supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase (solo servidor) — misma pantalla, "Secret key" (NUNCA subir a Git)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Cloudinary — Dashboard en cloudinary.com (opcional: sin esto las fotos van a public/uploads/)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# Admin — contraseña del vestuario (solo servidor)
ADMIN_PASSWORD=MiColeccion123!
